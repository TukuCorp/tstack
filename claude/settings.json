{
  "permissions": {
    "allow": [],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "skillOverrides": {
    "tldraw-offline": "off",
    "anthropic-skills:algorithmic-art": "off",
    "anthropic-skills:canvas-design": "off",
    "anthropic-skills:theme-factory": "off",
    "anthropic-skills:web-artifacts-builder": "off",
    "anthropic-skills:mcp-builder": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:doc-coauthoring": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:plan": "off",
    "anthropic-skills:present": "off",
    "anthropic-skills:research": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\<USER>\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "discord@claude-plugins-official": false,
    "typesafe@typesafe-ai": true,
    "apollo@synced": false,
    "pdf-viewer@synced": false,
    "design@synced": false,
    "operations@synced": false,
    "engineering@synced": false,
    "human-resources@synced": false,
    "productivity@synced": false,
    "product-management@synced": false,
    "marketing@synced": false,
    "legal@synced": false,
    "sales@synced": false,
    "finance@synced": false,
    "bio-research@synced": false,
    "data@synced": false,
    "cowork-plugin-management@synced": false,
    "enterprise-search@synced": false,
    "frontend-design@anthropic-plugin-directory": true,
    "code-modernization@anthropic-plugin-directory": true,
    "plugin-dev@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "HKUDS/CLI-Anything"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(uv run:*) in C:\\Users\\<USER>\\Downloads\\baby-context",
      "Bash(uv:*) in C:\\Users\\<USER>\\Downloads\\baby-context \u2014 declared-dependency toolchain use"
    ],
    "soft_deny": [
      "$defaults"
    ],
    "environment": [
