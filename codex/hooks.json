{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "quota-axi --provider codex --max-age 5m --no-credential-refresh",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "sh 'C:\\Users\\<USER>\\skills\\tldraw-offline\\inject-server-context.sh' SubagentStart",
            "type": "command"
          }
        ],
        "matcher": "tldraw-offline"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python -X utf8 C:/Users/<USER>/.codex/hooks/inline-script-guard.py"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
