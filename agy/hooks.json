{
  "inline-script-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python -X utf8 C:/Users/<USER>/.gemini/config/hooks/inline-script-guard.py"
          }
        ]
      }
    ]
  }
}
